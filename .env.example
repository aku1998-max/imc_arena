# IMC Arena environment template. Copy to .env for local development.
# NEVER commit a .env file containing real secrets. Production values live in a secret manager.

# ---- PUBLIC (safe to ship in client bundles; Expo uses the EXPO_PUBLIC_ prefix) ----
API_BASE_URL=http://localhost:3000
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# ---- SERVER ----
ENVIRONMENT=development            # development | test | staging | production
PORT=3000
# Runtime identity: not an owner, not superuser, not BYPASSRLS. Must be named imc_api.
DATABASE_URL=postgres://imc_api:local-runtime-password@localhost:5432/imc_arena
# Migration identity (owner). Used only by `pnpm db:migrate`, never by the API or worker.
DATABASE_MIGRATION_URL=postgres://imc_owner:local-owner-password@localhost:5432/imc_arena
# Superuser URL used only by `pnpm db:bootstrap` for local/CI role creation.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Adult/staff identity (Supabase Auth). Tokens are verified for signature, issuer, audience, expiry.
AUTH_ISSUER=http://localhost:54321/auth/v1
AUTH_AUDIENCE=authenticated
# Either a JWKS URL (asymmetric signing keys, preferred) ...
AUTH_JWKS_URL=
# ... or the legacy shared JWT secret (local Supabase / development only).
AUTH_JWT_SECRET=local-development-jwt-secret-at-least-32-chars
# Require staff aal2 (MFA) tokens. Forced on in production.
STAFF_REQUIRE_MFA=false

# Private media storage. STORAGE_DRIVER=local is an explicit development mock.
STORAGE_DRIVER=local
STORAGE_BUCKET=imc-private
STORAGE_SERVER_CREDENTIAL=local-storage-signing-secret-change-me
STORAGE_LOCAL_DIR=.var/storage

# Billing. BILLING_DRIVER=mock is an explicit development adapter; it never charges anyone.
BILLING_DRIVER=mock
BILLING_WEBHOOK_SECRET=local-webhook-secret-change-me
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=pro
BILLING_PRODUCT_IDS=imc_pro_monthly,imc_pro_annual

# Email delivery. EMAIL_DRIVER=log writes redacted messages to the log instead of sending.
EMAIL_DRIVER=log
EMAIL_PROVIDER_KEY=

ALLOWED_ADMIN_ORIGINS=http://localhost:5173
RATE_LIMIT_GLOBAL_MAX=600
LOG_LEVEL=info
